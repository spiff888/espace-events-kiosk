# Copy to .env and fill in. .env is ignored by Git and Docker builds, so the key never leaves this machine.

# eSPACE API key (a UUID). An eSPACE admin creates one in eSPACE; see eSPACE's support article "APIv2 | Keys & Tokens".
# The server exchanges it for an access token automatically.
ESPACE_API_KEY=

# Time zone for the server (campus boards can override theirs in config.json).
TZ=America/Los_Angeles
