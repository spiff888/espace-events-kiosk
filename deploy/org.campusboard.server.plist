<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS server: copy to /Library/LaunchDaemons/, then
     sudo launchctl bootstrap system /Library/LaunchDaemons/org.campusboard.server.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.campusboard.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/usr/local/campus-board/server.js</string>
  </array>
  <key>WorkingDirectory</key><string>/usr/local/campus-board</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/usr/local/campus-board/data/server.log</string>
  <key>StandardErrorPath</key><string>/usr/local/campus-board/data/server.log</string>
</dict>
</plist>
